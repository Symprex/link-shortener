# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
./logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Vite build output for the redirect Worker (vite.worker.config.ts), kept out of `dist`
# so it cannot interleave with the legacy Nuxt build. Note what is NOT here any more:
# src/links.generated.ts. The links map is no longer a file at all — it is the virtual
# module virtual:links, built from links/*.json by scripts/vite-plugin-links.ts, so
# there is one copy of the truth and no second file to go stale or be written over.
.worker-build

# Generated by `wrangler types` for tsconfig.worker.json's type gate — regenerated from
# wrangler.worker.jsonc on every typecheck run, not a second copy of the truth either
worker-configuration.d.ts

# Local env files
.env
.env.*
!.env.example
.wrangler
site
cache
public/world.json

# Symprex workflow session state
.symprex/STATE.md

# Symprex prototype harness: working files
.symprex/prototypes/**
