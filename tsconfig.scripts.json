{
  // Type-checks the plain-Node side of the new tree: scripts/*.ts (validate-links.ts,
  // generate-links.ts and their tests) plus src/test/global-setup.ts, which runs in the
  // same host process as these scripts, not inside the Workers runtime — see
  // tsconfig.worker.json for why that file lives here rather than there.
  //
  // build-map.js and build-colo.js are deliberately not included: they are legacy Nuxt
  // build helpers (see .symprex/config.json), covered by the app scope's ESLint rather
  // than this gate.
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["scripts/*.ts", "src/test/global-setup.ts"]
}
