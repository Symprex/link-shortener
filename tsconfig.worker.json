{
  // Type-checks the Worker itself (src/**), running inside the Workers runtime — hence
  // the ambient globals from worker-configuration.d.ts (generated by `wrangler types`,
  // which package.json's typecheck:worker script runs first) rather than any DOM or
  // Node lib.
  // Deliberately does not extend ./tsconfig.json: that file is entirely Nuxt's (it
  // extends .nuxt/tsconfig.json, generated for a Vue/Nitro app with nothing to do with a
  // plain Worker).
  //
  // src/test/global-setup.ts is excluded: it is Node-side Vitest scaffolding (it runs in
  // the host process before the Workers pool starts, not inside the runtime), so it
  // belongs with scripts/** in tsconfig.scripts.json instead — mixing @types/node's
  // ambient globals into this project reintroduces exactly the URL/Response/fetch
  // conflicts the split avoids (D19/typescript.md: keep Node types in their own
  // project).
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["src/test/global-setup.ts"]
}
