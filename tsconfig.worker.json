{
  // Type-checks the Worker itself (src/**), running inside the Workers runtime — hence
  // the ambient globals from worker-configuration.d.ts (generated by `wrangler types`,
  // which package.json's typecheck:worker script runs first) rather than any DOM or
  // Node lib.
  // Deliberately does not extend ./tsconfig.json: that file is entirely Nuxt's (it
  // extends .nuxt/tsconfig.json, generated for a Vue/Nitro app with nothing to do with a
  // plain Worker).
  //
  // src/virtual-links.d.ts is what makes `import { links } from "virtual:links"`
  // type-check here: the module is built by scripts/vite-plugin-links.ts at bundle time
  // and has no file for the compiler to read.
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
